# Operating System Files
# =========================
.DS_Store
Thumbs.db

# =========================
# IDEs & Editors
# =========================
.idea/
.vscode/*

# Keep Claude-specific settings and essential VS Code configs
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
!.vscode/*.claude*
!.claude.json
!.clinerules
!.clauderc

# =========================
# Backend (Python / FastAPI / uv)
# =========================
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env
.env.*
.uv.cache/
*.json
!package.json
!package-lock.json
!tsconfig.json
# =========================
# Frontend (React / npm)
# =========================
node_modules/
build/
dist/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.eslintcache

# Ignored User and Generated Data
backend/input_docs/*
!backend/input_docs/.gitkeep
backend/processed_docs/*
!backend/processed_docs/.gitkeep
backend/output_audio/*
